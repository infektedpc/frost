diff --git a/components/script/dom/media/sourcebuffer.rs b/components/script/dom/media/sourcebuffer.rs
new file mode 100644
index 000000000..125bc1b29
--- /dev/null
+++ b/components/script/dom/media/sourcebuffer.rs
@@ -0,0 +1,344 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! The `SourceBuffer` interface.
+//! <https://w3c.github.io/media-source/#sourcebuffer>
+//!
+//! Round 18 (MSE foundation): the full attribute/state-machine surface
+//! is present so pages can attach and append, but `appendBuffer` only
+//! queues bytes — `buffered` stays empty until Round 19 consumes the
+//! queue in the media thread and reports decoded ranges. Nothing here
+//! pretends a frame was decoded.
+
+use std::cell::Cell;
+
+use dom_struct::dom_struct;
+use js::context::JSContext;
+use js::rust::HandleObject;
+use script_bindings::buffer_source::get_buffer_source_copy;
+use script_bindings::cell::DomRefCell;
+use script_bindings::reflector::reflect_dom_object_with_proto;
+use stylo_atoms::Atom;
+
+use crate::dom::bindings::codegen::Bindings::MediaSourceBinding::MediaSourceReadyState;
+use crate::dom::bindings::codegen::Bindings::SourceBufferBinding::{
+    AppendMode, SourceBufferMethods,
+};
+use crate::dom::bindings::codegen::UnionTypes::ArrayBufferViewOrArrayBuffer as BufferSource;
+use crate::dom::bindings::error::{Error, ErrorResult, Fallible};
+use crate::dom::bindings::inheritance::Castable;
+use crate::dom::bindings::num::Finite;
+use crate::dom::bindings::refcounted::Trusted;
+use crate::dom::bindings::reflector::DomGlobal;
+use crate::dom::bindings::root::{Dom, DomRoot, MutNullableDom};
+use crate::dom::bindings::str::DOMString;
+use crate::dom::eventtarget::EventTarget;
+use crate::dom::audio::audiotracklist::AudioTrackList;
+use crate::dom::media::mediasource::MediaSource;
+use crate::dom::media::videotracklist::VideoTrackList;
+use crate::dom::timeranges::{TimeRanges, TimeRangesContainer};
+use crate::dom::window::Window;
+
+/// Bytes handed to `appendBuffer`, waiting for the decode pipeline.
+/// Round 19 consumes this queue in the media thread.
+#[derive(JSTraceable, MallocSizeOf)]
+pub(crate) struct QueuedAppend {
+    pub(crate) bytes: Vec<u8>,
+}
+
+#[dom_struct]
+pub(crate) struct SourceBuffer {
+    eventtarget: EventTarget,
+    mode: Cell<AppendMode>,
+    updating: Cell<bool>,
+    timestamp_offset: Cell<f64>,
+    append_window_start: Cell<f64>,
+    append_window_end: Cell<f64>,
+    /// The MIME type this buffer was created for.
+    mime_type: DomRefCell<DOMString>,
+    media_source: Dom<MediaSource>,
+    buffered: MutNullableDom<TimeRanges>,
+    audio_tracks: MutNullableDom<AudioTrackList>,
+    video_tracks: MutNullableDom<VideoTrackList>,
+    /// Bytes appended but not yet decoded (Round 19 consumes this).
+    pending_bytes: DomRefCell<Vec<QueuedAppend>>,
+}
+
+impl SourceBuffer {
+    fn new_inherited(media_source: &MediaSource, mime_type: DOMString) -> SourceBuffer {
+        SourceBuffer {
+            eventtarget: EventTarget::new_inherited(),
+            mode: Cell::new(AppendMode::Segments),
+            updating: Cell::new(false),
+            timestamp_offset: Cell::new(0.),
+            append_window_start: Cell::new(0.),
+            append_window_end: Cell::new(f64::INFINITY),
+            mime_type: DomRefCell::new(mime_type),
+            media_source: Dom::from_ref(media_source),
+            buffered: MutNullableDom::new(None),
+            audio_tracks: MutNullableDom::new(None),
+            video_tracks: MutNullableDom::new(None),
+            pending_bytes: DomRefCell::new(Vec::new()),
+        }
+    }
+
+    pub(crate) fn new(
+        cx: &mut JSContext,
+        global: &Window,
+        proto: Option<HandleObject>,
+        media_source: &MediaSource,
+        mime_type: DOMString,
+    ) -> DomRoot<SourceBuffer> {
+        reflect_dom_object_with_proto(
+            cx,
+            Box::new(SourceBuffer::new_inherited(media_source, mime_type)),
+            global,
+            proto,
+        )
+    }
+
+    pub(crate) fn is_updating(&self) -> bool {
+        self.updating.get()
+    }
+
+    fn queue_event(&self, name: &'static str) {
+        let this = Trusted::new(self);
+        let name = Atom::from(name);
+        self.global()
+            .task_manager()
+            .dom_manipulation_task_source()
+            .queue(task!(source_buffer_event: move |cx| {
+                let this = this.root();
+                this.upcast::<EventTarget>().fire_event(cx, name);
+            }));
+    }
+
+    fn buffered_list(&self, cx: &mut JSContext) -> DomRoot<TimeRanges> {
+        // Round 18: always empty — no data has been decoded yet.
+        let global = self.global();
+        let window = global.as_window();
+        self.buffered
+            .or_init(|| TimeRanges::new(cx, window, TimeRangesContainer::default()))
+    }
+
+    fn audio_tracks_list(&self, cx: &mut JSContext) -> DomRoot<AudioTrackList> {
+        // Round 18: no data, so no tracks are known yet.
+        let global = self.global();
+        let window = global.as_window();
+        self.audio_tracks
+            .or_init(|| AudioTrackList::new(cx, window, &[], None))
+    }
+
+    fn video_tracks_list(&self, cx: &mut JSContext) -> DomRoot<VideoTrackList> {
+        // Round 18: no data, so no tracks are known yet.
+        let global = self.global();
+        let window = global.as_window();
+        self.video_tracks
+            .or_init(|| VideoTrackList::new(cx, window, &[], None))
+    }
+
+    fn check_not_updating(&self) -> Fallible<()> {
+        if self.updating.get() {
+            return Err(Error::InvalidState(Some(
+                "SourceBuffer is updating".into(),
+            )));
+        }
+        Ok(())
+    }
+
+    fn check_open(&self) -> Fallible<()> {
+        if self.media_source.ready_state() != MediaSourceReadyState::Open {
+            return Err(Error::InvalidState(Some(
+                "MediaSource is not open".into(),
+            )));
+        }
+        Ok(())
+    }
+
+    fn finish_update(&self) {
+        let this = Trusted::new(self);
+        self.global()
+            .task_manager()
+            .dom_manipulation_task_source()
+            .queue(task!(source_buffer_update_end: move |cx| {
+                let this = this.root();
+                this.updating.set(false);
+                this.upcast::<EventTarget>()
+                    .fire_event(cx, Atom::from("updateend"));
+            }));
+    }
+}
+
+impl SourceBufferMethods<crate::DomTypeHolder> for SourceBuffer {
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-mode>
+    fn Mode(&self) -> AppendMode {
+        self.mode.get()
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-mode>
+    fn SetMode(&self, value: AppendMode) -> ErrorResult {
+        if self.updating.get() {
+            return Err(Error::InvalidState(Some(
+                "Cannot change mode while the SourceBuffer is updating".into(),
+            )));
+        }
+        self.mode.set(value);
+        Ok(())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-updating>
+    fn Updating(&self) -> bool {
+        self.updating.get()
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-buffered>
+    fn Buffered(&self, cx: &mut JSContext) -> DomRoot<TimeRanges> {
+        self.buffered_list(cx)
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-timestampoffset>
+    fn TimestampOffset(&self) -> Finite<f64> {
+        Finite::wrap(self.timestamp_offset.get())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-timestampoffset>
+    fn SetTimestampOffset(&self, value: Finite<f64>) -> ErrorResult {
+        if self.updating.get() {
+            return Err(Error::InvalidState(Some(
+                "Cannot change timestampOffset while the SourceBuffer is updating".into(),
+            )));
+        }
+        self.timestamp_offset.set(*value);
+        Ok(())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-audiotracks>
+    fn AudioTracks(&self, cx: &mut JSContext) -> DomRoot<AudioTrackList> {
+        self.audio_tracks_list(cx)
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-videotracks>
+    fn VideoTracks(&self, cx: &mut JSContext) -> DomRoot<VideoTrackList> {
+        self.video_tracks_list(cx)
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-appendwindowstart>
+    fn AppendWindowStart(&self) -> Finite<f64> {
+        Finite::wrap(self.append_window_start.get())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-appendwindowstart>
+    fn SetAppendWindowStart(&self, value: Finite<f64>) -> ErrorResult {
+        if self.updating.get() {
+            return Err(Error::InvalidState(Some(
+                "Cannot change appendWindowStart while the SourceBuffer is updating".into(),
+            )));
+        }
+        if *value < 0. || *value > self.append_window_end.get() {
+            return Err(Error::Type(
+                c"appendWindowStart must be >= 0 and <= appendWindowEnd".to_owned(),
+            ));
+        }
+        self.append_window_start.set(*value);
+        Ok(())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-appendwindowend>
+    fn AppendWindowEnd(&self) -> Finite<f64> {
+        Finite::wrap(self.append_window_end.get())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-appendwindowend>
+    fn SetAppendWindowEnd(&self, value: Finite<f64>) -> ErrorResult {
+        if self.updating.get() {
+            return Err(Error::InvalidState(Some(
+                "Cannot change appendWindowEnd while the SourceBuffer is updating".into(),
+            )));
+        }
+        if *value < self.append_window_start.get() {
+            return Err(Error::Type(
+                c"appendWindowEnd must be >= appendWindowStart".to_owned(),
+            ));
+        }
+        self.append_window_end.set(*value);
+        Ok(())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-appendbuffer>
+    fn AppendBuffer(&self, data: BufferSource) -> Fallible<()> {
+        self.check_not_updating()?;
+        self.check_open()?;
+        let bytes = get_buffer_source_copy((&data).into());
+        self.pending_bytes
+            .borrow_mut()
+            .push(QueuedAppend { bytes });
+        self.updating.set(true);
+        self.queue_event("updatestart");
+        self.queue_event("update");
+        // `updating` stays true until the `updateend` task runs: a page
+        // that reads `updating` between the append call and the queued
+        // task sees the spec-correct value.
+        self.finish_update();
+        Ok(())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-abort>
+    fn Abort(&self) -> Fallible<()> {
+        if self.media_source.ready_state() != MediaSourceReadyState::Open {
+            return Err(Error::InvalidState(Some(
+                "Cannot abort a SourceBuffer whose MediaSource is not open".into(),
+            )));
+        }
+        self.pending_bytes.borrow_mut().clear();
+        if self.updating.get() {
+            self.updating.set(false);
+            self.queue_event("abort");
+            self.queue_event("updateend");
+        }
+        Ok(())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-changetype>
+    fn ChangeType(&self, type_: DOMString) -> Fallible<()> {
+        self.check_not_updating()?;
+        if !MediaSource::is_type_supported(&type_) {
+            return Err(Error::NotSupported(Some(
+                "MIME type is not supported".into(),
+            )));
+        }
+        *self.mime_type.borrow_mut() = type_;
+        Ok(())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebuffer-remove>
+    fn Remove(&self, start: Finite<f64>, end: Finite<f64>) -> Fallible<()> {
+        self.check_not_updating()?;
+        self.check_open()?;
+        if !(*start < *end) {
+            return Err(Error::Type(c"remove() requires start < end".to_owned()));
+        }
+        // Round 18: nothing is buffered, so the range to remove is
+        // empty — but the state machine still reports an update.
+        self.updating.set(true);
+        self.queue_event("updatestart");
+        self.queue_event("update");
+        self.finish_update();
+        Ok(())
+    }
+
+    // https://w3c.github.io/media-source/#handler-sourcebuffer-onupdatestart
+    event_handler!(updatestart, GetOnupdatestart, SetOnupdatestart);
+
+    // https://w3c.github.io/media-source/#handler-sourcebuffer-onupdate
+    event_handler!(update, GetOnupdate, SetOnupdate);
+
+    // https://w3c.github.io/media-source/#handler-sourcebuffer-onupdateend
+    event_handler!(updateend, GetOnupdateend, SetOnupdateend);
+
+    // https://w3c.github.io/media-source/#handler-sourcebuffer-onerror
+    event_handler!(error, GetOnerror, SetOnerror);
+
+    // https://w3c.github.io/media-source/#handler-sourcebuffer-onabort
+    event_handler!(abort, GetOnabort, SetOnabort);
+}
