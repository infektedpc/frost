new file mode 100644
index 000000000..22a318904
--- /dev/null
+++ b/components/script/dom/media/sourcebufferlist.rs
@@ -0,0 +1,127 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! The `SourceBufferList` interface.
+//! <https://w3c.github.io/media-source/#sourcebufferlist>
+//!
+//! Round 18 (MSE foundation): the list mirrors `VideoTrackList` — it is
+//! the storage for a `MediaSource`'s source buffers, and fires
+//! `addsourcebuffer` / `removesourcebuffer` when the set changes.
+
+use dom_struct::dom_struct;
+use js::context::JSContext;
+use script_bindings::cell::DomRefCell;
+use script_bindings::reflector::{reflect_dom_object, reflect_dom_object_with_proto};
+use stylo_atoms::Atom;
+
+use crate::dom::bindings::codegen::Bindings::SourceBufferListBinding::SourceBufferListMethods;
+use crate::dom::bindings::inheritance::Castable;
+use crate::dom::bindings::refcounted::Trusted;
+use crate::dom::bindings::reflector::DomGlobal;
+use crate::dom::bindings::root::{Dom, DomRoot};
+use crate::dom::eventtarget::EventTarget;
+use crate::dom::media::sourcebuffer::SourceBuffer;
+use crate::dom::window::Window;
+
+#[dom_struct]
+pub(crate) struct SourceBufferList {
+    eventtarget: EventTarget,
+    buffers: DomRefCell<Vec<Dom<SourceBuffer>>>,
+}
+
+impl SourceBufferList {
+    fn new_inherited() -> SourceBufferList {
+        SourceBufferList {
+            eventtarget: EventTarget::new_inherited(),
+            buffers: DomRefCell::new(vec![]),
+        }
+    }
+
+    pub(crate) fn new(cx: &mut JSContext, global: &Window) -> DomRoot<SourceBufferList> {
+        reflect_dom_object(
+            cx,
+            Box::new(SourceBufferList::new_inherited()),
+            global,
+        )
+    }
+
+    pub(crate) fn len(&self) -> usize {
+        self.buffers.borrow().len()
+    }
+
+    pub(crate) fn item(&self, idx: usize) -> Option<DomRoot<SourceBuffer>> {
+        self.buffers
+            .borrow()
+            .get(idx)
+            .map(|buffer| DomRoot::from_ref(&**buffer))
+    }
+
+    pub(crate) fn contains(&self, buffer: &SourceBuffer) -> bool {
+        self.buffers.borrow().iter().any(|b| &**b == buffer)
+    }
+
+    pub(crate) fn add(&self, buffer: &SourceBuffer) {
+        self.buffers.borrow_mut().push(Dom::from_ref(buffer));
+
+        let this = Trusted::new(self);
+        self.global()
+            .task_manager()
+            .dom_manipulation_task_source()
+            .queue(task!(add_source_buffer: move |cx| {
+                let this = this.root();
+                this.upcast::<EventTarget>()
+                    .fire_event(cx, Atom::from("addsourcebuffer"));
+            }));
+    }
+
+    pub(crate) fn remove(&self, buffer: &SourceBuffer) {
+        let mut buffers = self.buffers.borrow_mut();
+        if let Some(pos) = buffers.iter().position(|b| &**b == buffer) {
+            buffers.remove(pos);
+        } else {
+            return;
+        }
+        drop(buffers);
+
+        let this = Trusted::new(self);
+        self.global()
+            .task_manager()
+            .dom_manipulation_task_source()
+            .queue(task!(remove_source_buffer: move |cx| {
+                let this = this.root();
+                this.upcast::<EventTarget>()
+                    .fire_event(cx, Atom::from("removesourcebuffer"));
+            }));
+    }
+
+    pub(crate) fn clear(&self) {
+        self.buffers.borrow_mut().clear();
+    }
+}
+
+impl SourceBufferListMethods<crate::DomTypeHolder> for SourceBufferList {
+    /// <https://w3c.github.io/media-source/#dom-sourcebufferlist-length>
+    fn Length(&self) -> u32 {
+        self.len() as u32
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-sourcebufferlist-getter>
+    fn IndexedGetter(&self, idx: u32) -> Option<DomRoot<SourceBuffer>> {
+        self.item(idx as usize)
+    }
+
+    // https://w3c.github.io/media-source/#handler-sourcebufferlist-onaddsourcebuffer
+    event_handler!(
+        addsourcebuffer,
+        GetOnaddsourcebuffer,
+        SetOnaddsourcebuffer
+    );
+
+    // https://w3c.github.io/media-source/#handler-sourcebufferlist-onremovesourcebuffer
+    event_handler!(
+        removesourcebuffer,
+        GetOnremovesourcebuffer,
+        SetOnremovesourcebuffer
+    );
+}
diff --git a/components/script/dom/url/url.rs b/components/script/dom/url/url.rs
index 7af3ab63a..38ab6b102 100644
--- a/components/script/dom/url/url.rs
+++ b/components/script/dom/url/url.rs
@@ -22,12 +22,14 @@ use url::Url;
 use uuid::Uuid;
 
 use crate::dom::bindings::codegen::Bindings::URLBinding::URLMethods;
+use crate::dom::bindings::codegen::UnionTypes::BlobOrMediaSource;
 use crate::dom::bindings::error::{Error, ErrorResult, Fallible};
 use crate::dom::bindings::reflector::DomGlobal;
 use crate::dom::bindings::root::{DomRoot, MutNullableDom};
 use crate::dom::bindings::str::{DOMString, USVString};
 use crate::dom::blob::Blob;
 use crate::dom::globalscope::GlobalScope;
+use crate::dom::media::mediasource::MediaSource;
 use crate::dom::url::urlhelper::UrlHelper;
 use crate::dom::url::urlsearchparams::URLSearchParams;
 
@@ -94,6 +96,36 @@ impl URL {
         }
     }
 
+    /// <https://w3c.github.io/FileAPI/#dfn-createObjectURL>
+    fn create_object_url_for_blob(global: &GlobalScope, blob: &Blob) -> DOMString {
+        // XXX: Second field is an unicode-serialized Origin, it is a temporary workaround
+        //      and should not be trusted. See issue https://github.com/servo/servo/issues/11722
+        let origin = global.origin();
+
+        let id = blob.get_blob_url_id();
+
+        DOMString::from(URL::unicode_serialization_blob_url(origin.immutable(), &id))
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-url-createobjecturl>
+    /// A `MediaSource` has no bytes for the file manager to serve, so its
+    /// `blob:` URL is registered in the global's MediaSource map instead
