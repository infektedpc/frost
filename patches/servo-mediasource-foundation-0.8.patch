diff --git a/components/script/dom/media/mediasource.rs b/components/script/dom/media/mediasource.rs
new file mode 100644
index 000000000..f0ee22d41
--- /dev/null
+++ b/components/script/dom/media/mediasource.rs
@@ -0,0 +1,308 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! The `MediaSource` interface.
+//! <https://w3c.github.io/media-source/#mediasource>
+//!
+//! Round 18 (MSE foundation): the object exists, is constructible,
+//! answers `isTypeSupported`, holds `SourceBuffer`s, and attaches to a
+//! media element with the `closed` → `open` readyState transition and a
+//! `sourceopen` event. It does NOT feed data to a decoder yet —
+//! `SourceBuffer.appendBuffer` queues bytes for the decode pipeline
+//! (Round 19), and hardware decode is a later stage after that.
+
+use std::cell::Cell;
+
+use dom_struct::dom_struct;
+use js::context::JSContext;
+use js::rust::HandleObject;
+use script_bindings::cell::DomRefCell;
+use script_bindings::reflector::reflect_dom_object_with_proto;
+use servo_media::{ServoMedia, SupportsMediaType};
+use stylo_atoms::Atom;
+
+use crate::dom::bindings::codegen::Bindings::MediaSourceBinding::{
+    EndOfStreamError, MediaSourceMethods, MediaSourceReadyState,
+};
+use crate::dom::bindings::error::{Error, ErrorResult, Fallible};
+use crate::dom::bindings::inheritance::Castable;
+use crate::dom::bindings::num::Finite;
+use crate::dom::bindings::refcounted::Trusted;
+use crate::dom::bindings::reflector::DomGlobal;
+use crate::dom::bindings::root::{DomRoot, MutNullableDom};
+use crate::dom::bindings::str::DOMString;
+use crate::dom::eventtarget::EventTarget;
+use crate::dom::html::htmlmediaelement::HTMLMediaElement;
+use crate::dom::media::sourcebuffer::SourceBuffer;
+use crate::dom::media::sourcebufferlist::SourceBufferList;
+use crate::dom::window::Window;
+
+#[dom_struct]
+pub(crate) struct MediaSource {
+    eventtarget: EventTarget,
+    ready_state: Cell<MediaSourceReadyState>,
+    duration: Cell<f64>,
+    source_buffers: MutNullableDom<SourceBufferList>,
+    active_source_buffers: MutNullableDom<SourceBufferList>,
+    /// The media element this source is attached to, if any.
+    attached_element: MutNullableDom<HTMLMediaElement>,
+    live_seekable_range: DomRefCell<Option<(f64, f64)>>,
+}
+
+impl MediaSource {
+    fn new_inherited() -> MediaSource {
+        MediaSource {
+            eventtarget: EventTarget::new_inherited(),
+            ready_state: Cell::new(MediaSourceReadyState::Closed),
+            duration: Cell::new(f64::NAN),
+            source_buffers: MutNullableDom::new(None),
+            active_source_buffers: MutNullableDom::new(None),
+            attached_element: MutNullableDom::new(None),
+            live_seekable_range: DomRefCell::new(None),
+        }
+    }
+
+    pub(crate) fn new(
+        cx: &mut JSContext,
+        global: &Window,
+        proto: Option<HandleObject>,
+    ) -> DomRoot<MediaSource> {
+        reflect_dom_object_with_proto(
+            cx,
+            Box::new(MediaSource::new_inherited()),
+            global,
+            proto,
+        )
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-mediasource-istypesupported>
+    pub(crate) fn is_type_supported(type_: &DOMString) -> bool {
+        ServoMedia::get().can_play_type(&type_.str()) != SupportsMediaType::No
+    }
+
+    pub(crate) fn ready_state(&self) -> MediaSourceReadyState {
+        self.ready_state.get()
+    }
+
+    fn queue_event(&self, name: &'static str) {
+        let this = Trusted::new(self);
+        let name = Atom::from(name);
+        self.global()
+            .task_manager()
+            .dom_manipulation_task_source()
+            .queue(task!(media_source_event: move |cx| {
+                let this = this.root();
+                this.upcast::<EventTarget>().fire_event(cx, name);
+            }));
+    }
+
+    fn source_buffers_list(&self, cx: &mut JSContext) -> DomRoot<SourceBufferList> {
+        let global = self.global();
+        let window = global.as_window();
+        self.source_buffers
+            .or_init(|| SourceBufferList::new(cx, window))
+    }
+
+    fn active_source_buffers_list(&self, cx: &mut JSContext) -> DomRoot<SourceBufferList> {
+        let global = self.global();
+        let window = global.as_window();
+        self.active_source_buffers
+            .or_init(|| SourceBufferList::new(cx, window))
+    }
+
+    /// <https://w3c.github.io/media-source/#mediasource-attach>
+    /// Attach this source to a media element: readyState becomes "open"
+    /// and a `sourceopen` event is queued. The queued task also clears
+    /// the element's delaying-the-load-event flag — the attach steps are
+    /// the end of the load for the element (no fetch follows), so the
+    /// document's load event must not wait on it.
+    pub(crate) fn attach_to_media_element(&self, element: &HTMLMediaElement) {
+        self.attached_element.set(Some(element));
+        self.ready_state.set(MediaSourceReadyState::Open);
+        let this = Trusted::new(self);
+        let element = Trusted::new(element);
+        self.global()
+            .task_manager()
+            .dom_manipulation_task_source()
+            .queue(task!(media_source_open: move |cx| {
+                let this = this.root();
+                this.upcast::<EventTarget>()
+                    .fire_event(cx, Atom::from("sourceopen"));
+                let element = element.root();
+                element.delay_load_event(cx, false);
+            }));
+    }
+
+    /// <https://w3c.github.io/media-source/#mediasource-detach>
+    /// Detach from the media element: readyState becomes "closed", all
+    /// source buffers are dropped, duration resets, `sourceclose` fires.
+    pub(crate) fn detach(&self) {
+        if let Some(list) = self.source_buffers.get() {
+            list.clear();
+        }
+        if let Some(list) = self.active_source_buffers.get() {
+            list.clear();
+        }
+        self.attached_element.set(None);
+        self.duration.set(f64::NAN);
+        self.live_seekable_range.borrow_mut().take();
+        self.ready_state.set(MediaSourceReadyState::Closed);
+        self.queue_event("sourceclose");
+    }
+}
+
+impl MediaSourceMethods<crate::DomTypeHolder> for MediaSource {
+    /// <https://w3c.github.io/media-source/#dom-mediasource-constructor>
+    fn Constructor(
+        cx: &mut JSContext,
+        global: &Window,
+        proto: Option<HandleObject>,
+    ) -> DomRoot<MediaSource> {
+        MediaSource::new(cx, global, proto)
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-mediasource-sourcebuffers>
+    fn SourceBuffers(&self, cx: &mut JSContext) -> DomRoot<SourceBufferList> {
+        self.source_buffers_list(cx)
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-mediasource-activesourcebuffers>
+    fn ActiveSourceBuffers(&self, cx: &mut JSContext) -> DomRoot<SourceBufferList> {
+        // Round 18: no appended data, so no track is selected and no
+        // buffer is active yet. The list stays empty until Round 19.
+        self.active_source_buffers_list(cx)
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-mediasource-readystate>
+    fn ReadyState(&self) -> MediaSourceReadyState {
+        self.ready_state.get()
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-mediasource-duration>
+    fn Duration(&self) -> f64 {
+        self.duration.get()
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-mediasource-duration>
+    fn SetDuration(&self, duration: f64) -> ErrorResult {
+        if self.ready_state.get() == MediaSourceReadyState::Closed {
+            return Err(Error::InvalidState(Some(
+                "Cannot set duration on a closed MediaSource".into(),
+            )));
+        }
+        if duration.is_nan() || duration < 0. {
+            return Err(Error::Type(
+                c"duration must not be NaN or negative".to_owned(),
+            ));
+        }
+        self.duration.set(duration);
+        Ok(())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-mediasource-addsourcebuffer>
+    fn AddSourceBuffer(
+        &self,
+        cx: &mut JSContext,
+        type_: DOMString,
+    ) -> Fallible<DomRoot<SourceBuffer>> {
+        if self.ready_state.get() != MediaSourceReadyState::Open {
+            return Err(Error::InvalidState(Some(
+                "Cannot add a SourceBuffer to a MediaSource that is not open".into(),
+            )));
+        }
+        if !Self::is_type_supported(&type_) {
+            return Err(Error::NotSupported(Some(
+                "MIME type is not supported".into(),
+            )));
+        }
+        let global = self.global();
+        let window = global.as_window();
+        let buffer = SourceBuffer::new(cx, window, None, self, type_);
+        self.source_buffers_list(cx).add(&buffer);
+        Ok(buffer)
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-mediasource-removesourcebuffer>
+    fn RemoveSourceBuffer(&self, buffer: &SourceBuffer) -> Fallible<()> {
+        // If no list exists yet, nothing was ever added.
+        let Some(list) = self.source_buffers.get() else {
+            return Err(Error::NotFound(Some(
+                "SourceBuffer is not in sourceBuffers".into(),
+            )));
+        };
+        if !list.contains(buffer) {
+            return Err(Error::NotFound(Some(
+                "SourceBuffer is not in sourceBuffers".into(),
+            )));
+        }
+        if buffer.is_updating() {
+            return Err(Error::InvalidState(Some(
+                "Cannot remove a SourceBuffer while it is updating".into(),
+            )));
+        }
+        list.remove(buffer);
+        Ok(())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-mediasource-endofstream>
+    fn EndOfStream(&self, error: Option<EndOfStreamError>) -> Fallible<()> {
+        if self.ready_state.get() != MediaSourceReadyState::Open {
+            return Err(Error::InvalidState(Some(
+                "Cannot end a MediaSource stream that is not open".into(),
+            )));
+        }
+        // A "decode" error would set the media element's error; the
+        // element has no data yet in Round 18, so there is nothing to
+        // fail — the state change below is the observable part.
+        let _ = error;
+        self.ready_state.set(MediaSourceReadyState::Ended);
+        self.queue_event("sourceended");
+        Ok(())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-mediasource-setliveseekablerange>
+    fn SetLiveSeekableRange(
+        &self,
+        start: Finite<f64>,
+        end: Finite<f64>,
+    ) -> Fallible<()> {
+        if self.ready_state.get() != MediaSourceReadyState::Open {
+            return Err(Error::InvalidState(Some(
+                "Cannot set a live seekable range on a MediaSource that is not open".into(),
+            )));
+        }
+        if !(0. <= *start && *start <= *end) {
+            return Err(Error::Type(
+                c"live seekable range requires 0 <= start <= end".to_owned(),
+            ));
+        }
+        *self.live_seekable_range.borrow_mut() = Some((*start, *end));
+        Ok(())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-mediasource-clearliveseekablerange>
+    fn ClearLiveSeekableRange(&self) -> Fallible<()> {
+        if self.ready_state.get() != MediaSourceReadyState::Open {
+            return Err(Error::InvalidState(Some(
+                "Cannot clear a live seekable range on a MediaSource that is not open".into(),
+            )));
+        }
+        self.live_seekable_range.borrow_mut().take();
+        Ok(())
+    }
+
+    /// <https://w3c.github.io/media-source/#dom-mediasource-istypesupported>
+    fn IsTypeSupported(_global: &Window, type_: DOMString) -> bool {
+        Self::is_type_supported(&type_)
+    }
+
+    // https://w3c.github.io/media-source/#handler-mediasource-onsourceopen
+    event_handler!(sourceopen, GetOnsourceopen, SetOnsourceopen);
+
+    // https://w3c.github.io/media-source/#handler-mediasource-onsourceended
+    event_handler!(sourceended, GetOnsourceended, SetOnsourceended);
+
+    // https://w3c.github.io/media-source/#handler-mediasource-onsourceclose
+    event_handler!(sourceclose, GetOnsourceclose, SetOnsourceclose);
+}
