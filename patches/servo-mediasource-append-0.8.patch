+        subtract_range(&mut r, 0.0, 3.0);
+        assert_eq!(r, vec![(7.0, 10.0)]);
+        subtract_range(&mut r, 7.0, 10.0);
+        assert!(r.is_empty());
+        let mut r = vec![(0.0, 2.0), (4.0, 6.0)];
