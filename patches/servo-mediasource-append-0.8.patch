index 000000000..1a3c097d7
--- /dev/null
+++ b/components/script/dom/media/mp4.rs
@@ -0,0 +1,585 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Minimal ISO BMFF (MP4) box parsing for MSE `buffered` ranges.
+//!
+//! Round 19: the media thread knows what it decoded, but the
+//! `SourceBuffer.buffered` attribute must report the time ranges of
+//! the segments the page appended — and the GStreamer player's
+//! `buffered()` query needs a known total input size, which MSE never
+//! has (the stream is open-ended), so it reports nothing useful here.
+//! Instead the ranges are computed at append time from the segment
+//! boxes themselves: the init segment gives each track's timescale,
+//! and each media segment's `tfdt` (base decode time) plus `trun`
+//! sample durations give its presentation-time range. This is the
+//! spec's own accounting — MSE buffered ranges come from the appended
+//! coded frames, not from the demuxer.
+//!
+//! Only the boxes MSE needs are parsed (`ftyp` skipped, `moov` with
+//! `mvhd`/`trak`/`tkhd`/`mdia`/`mdhd`/`hdlr`, `moof` with
+//! `traf`/`tfhd`/`tfdt`/`trun`); everything else (`mdat`, `mfra`,
+//! `free`, …) is skipped by size without copying. Malformed or
+//! truncated input yields `None`/empty ranges, never a panic.
+
+/// One track from the init segment.
+#[derive(Clone, Copy, Debug, JSTraceable, MallocSizeOf, PartialEq)]
+pub(crate) struct Mp4TrackInfo {
+    pub(crate) track_id: u32,
+    pub(crate) timescale: u32,
+    /// e.g. `b"vide"` or `b"soun"`.
+    pub(crate) handler: [u8; 4],
+}
+
+/// What the init segment tells us about the stream.
+#[derive(Clone, Debug, Default, JSTraceable, MallocSizeOf, PartialEq)]
+pub(crate) struct Mp4InitInfo {
+    pub(crate) movie_timescale: u32,
+    /// Movie duration in seconds (0.0 for fragmented presentations,
+    /// whose `mvhd` duration is 0).
+    pub(crate) movie_duration: f64,
+    pub(crate) tracks: Vec<Mp4TrackInfo>,
+}
+
+impl Mp4InitInfo {
+    fn timescale_for(&self, track_id: u32) -> Option<u32> {
+        self.tracks
+            .iter()
+            .find(|t| t.track_id == track_id)
+            .map(|t| t.timescale)
+    }
+}
+
+fn read_u32(data: &[u8], offset: usize) -> Option<u32> {
+    data.get(offset..offset + 4)
+        .map(|b| u32::from_be_bytes([b[0], b[1], b[2], b[3]]))
+}
+
+fn read_u64(data: &[u8], offset: usize) -> Option<u64> {
+    data.get(offset..offset + 8)
+        .map(|b| u64::from_be_bytes([b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]]))
+}
+
+/// A parsed box header: type, where its content starts, and where the
+/// next sibling box starts. Returns `None` on truncated input.
+fn read_box(data: &[u8], offset: usize) -> Option<([u8; 4], usize, usize)> {
+    let size = read_u32(data, offset)? as u64;
+    let typ: [u8; 4] = data.get(offset + 4..offset + 8)?.try_into().ok()?;
+    let (header_size, total_size) = match size {
+        1 => (16, read_u64(data, offset + 8)?),
+        0 => (8, (data.len() - offset) as u64),
+        _ => (8, size),
+    };
+    if total_size < header_size as u64 || offset + total_size as usize > data.len() {
+        return None;
+    }
+    Some((
+        typ,
+        offset + header_size,
+        offset + total_size as usize,
+    ))
+}
+
+/// Iterate the child boxes of `data[start..end]`.
+fn children<F>(data: &[u8], start: usize, end: usize, mut f: F)
+where
+    F: FnMut([u8; 4], usize, usize),
+{
+    let mut offset = start;
+    while offset + 8 <= end {
+        let Some((typ, content, next)) = read_box(data, offset) else {
+            return;
+        };
+        if next > end {
+            return;
+        }
+        f(typ, content, next);
+        offset = next;
+    }
+}
+
+/// Parse an init segment (`ftyp` + `moov`). Returns `None` if no
+/// usable `moov` is present.
+pub(crate) fn parse_init_segment(bytes: &[u8]) -> Option<Mp4InitInfo> {
+    let mut init = Mp4InitInfo::default();
+    let mut found_moov = false;
+    children(bytes, 0, bytes.len(), |typ, content, next| {
+        if &typ != b"moov" {
+            return;
+        }
+        found_moov = true;
+        children(bytes, content, next, |typ, content, next| {
+            match &typ {
+                b"mvhd" => {
+                    let version = bytes.get(content).copied().unwrap_or(0);
+                    if version == 0 {
+                        if let (Some(timescale), Some(duration)) = (
+                            read_u32(bytes, content + 12),
+                            read_u32(bytes, content + 16),
+                        ) {
+                            init.movie_timescale = timescale;
+                            init.movie_duration = if timescale > 0 {
+                                duration as f64 / timescale as f64
+                            } else {
+                                0.0
+                            };
+                        }
+                    } else if let (Some(timescale), Some(duration)) = (
+                        read_u32(bytes, content + 20),
+                        read_u64(bytes, content + 24),
+                    ) {
+                        init.movie_timescale = timescale;
+                        init.movie_duration = if timescale > 0 {
+                            duration as f64 / timescale as f64
+                        } else {
+                            0.0
+                        };
+                    }
+                },
+                b"trak" => {
+                    let mut track_id = None;
+                    let mut timescale = None;
+                    let mut handler = None;
+                    children(bytes, content, next, |typ, content, next| {
+                        match &typ {
+                            b"tkhd" => {
+                                let version = bytes.get(content).copied().unwrap_or(0);
+                                let at = if version == 0 { content + 12 } else { content + 20 };
+                                track_id = read_u32(bytes, at);
+                            },
+                            b"mdia" => {
+                                children(bytes, content, next, |typ, content, _next| {
+                                    match &typ {
+                                        b"mdhd" => {
+                                            let version =
+                                                bytes.get(content).copied().unwrap_or(0);
+                                            let at = if version == 0 {
+                                                content + 12
+                                            } else {
+                                                content + 20
+                                            };
+                                            timescale = read_u32(bytes, at);
+                                        },
+                                        b"hdlr" => {
+                                            handler = bytes
+                                                .get(content + 8..content + 12)
+                                                .and_then(|b| b.try_into().ok());
+                                        },
+                                        _ => {},
+                                    }
+                                });
+                            },
+                            _ => {},
+                        }
+                    });
+                    if let (Some(track_id), Some(timescale), Some(handler)) =
+                        (track_id, timescale, handler)
+                    {
+                        init.tracks.push(Mp4TrackInfo {
+                            track_id,
+                            timescale,
+                            handler,
+                        });
+                    }
+                },
+                _ => {},
+            }
+        });
+    });
+    if found_moov {
+        Some(init)
+    } else {
+        None
+    }
+}
+
+/// Presentation-time ranges (seconds) covered by the media segments
+/// in `bytes`, using `init` for track timescales. A buffer may hold
+/// several segments; all their ranges are returned. Ranges from
+/// segments whose track is unknown, or whose sample durations cannot
+/// be determined, are skipped.
+pub(crate) fn segment_ranges(bytes: &[u8], init: &Mp4InitInfo) -> Vec<(f64, f64)> {
+    let mut ranges = Vec::new();
+    children(bytes, 0, bytes.len(), |typ, content, next| {
+        if &typ != b"moof" {
+            return;
+        }
+        children(bytes, content, next, |typ, content, next| {
+            if &typ != b"traf" {
+                return;
+            }
+            // One traf = one track's samples for this fragment.
+            let mut track_id = None;
+            let mut default_duration = None;
+            let mut base_decode_time = None;
+            // (trun start decode time offset, total duration) pairs,
+            // in file order; later truns continue where earlier ones end.
+            let mut trun_durations: Vec<u64> = Vec::new();
+            children(bytes, content, next, |typ, content, _next| {
+                match &typ {
+                    b"tfhd" => {
+                        track_id = read_u32(bytes, content + 4);
+                        let flags = read_u32(bytes, content).map(|v| v & 0x00ff_ffff);
+                        let flags = flags.unwrap_or(0);
+                        // Optional fields follow track_ID in flag order:
+                        // base-data-offset (8), sample-description-index (4),
+                        // default-sample-duration (4), default-sample-size (4),
+                        // default-sample-flags (4).
+                        let mut at = content + 8;
+                        if flags & 0x0000_01 != 0 {
+                            at += 8;
+                        }
+                        if flags & 0x0000_02 != 0 {
+                            at += 4;
+                        }
+                        if flags & 0x0000_08 != 0 {
+                            default_duration = read_u32(bytes, at).map(|v| v as u64);
+                        }
+                    },
+                    b"tfdt" => {
+                        let version = bytes.get(content).copied().unwrap_or(0);
+                        base_decode_time = if version == 0 {
+                            read_u32(bytes, content + 4).map(|v| v as u64)
+                        } else {
+                            read_u64(bytes, content + 4)
+                        };
+                    },
+                    b"trun" => {
+                        let flags = read_u32(bytes, content).map(|v| v & 0x00ff_ffff);
+                        let flags = flags.unwrap_or(0);
+                        let Some(count) = read_u32(bytes, content + 4).map(|v| v as usize) else {
+                            return;
+                        };
+                        let mut at = content + 8;
+                        if flags & 0x0000_01 != 0 {
+                            at += 4; // data-offset
+                        }
+                        if flags & 0x0000_04 != 0 {
+                            at += 4; // first-sample-flags
+                        }
+                        let per_sample = [
+                            flags & 0x0001_00 != 0, // sample-duration
+                            flags & 0x0002_00 != 0, // sample-size
+                            flags & 0x0004_00 != 0, // sample-flags
+                            flags & 0x0008_00 != 0, // sample-cts
+                        ];
+                        let entry_size =
+                            per_sample.iter().filter(|p| **p).count() * 4;
+                        let mut total = 0u64;
+                        let mut have_durations = false;
+                        for i in 0..count {
+                            let entry = at + i * entry_size;
+                            if per_sample[0] {
+                                if let Some(d) = read_u32(bytes, entry) {
+                                    total += d as u64;
+                                    have_durations = true;
+                                }
+                            }
+                        }
+                        if !have_durations {
+                            if let Some(default) = default_duration {
+                                total = default * count as u64;
+                                have_durations = true;
+                            }
+                        }
+                        if have_durations {
+                            trun_durations.push(total);
+                        }
+                    },
+                    _ => {},
+                }
+            });
+            let Some(track_id) = track_id else { return };
+            let Some(timescale) = init.timescale_for(track_id) else {
+                return;
+            };
+            let Some(mut decode_time) = base_decode_time else {
+                return;
+            };
+            if timescale == 0 {
+                return;
+            }
+            for total in trun_durations {
+                let start = decode_time as f64 / timescale as f64;
+                let end = (decode_time + total) as f64 / timescale as f64;
+                if end > start {
+                    ranges.push((start, end));
+                }
+                decode_time += total;
+            }
+        });
+    });
+    ranges
+}
+
+/// Parse one appended buffer, which may hold an init segment, media
+/// segments, or both (YouTube sometimes appends init + first segment
+/// in one call). Returns the init info found in this buffer (if any)
+/// and the segment ranges it covers. Pass the previously-known init
+/// info in `known_init` so segments appended before any init segment
+/// in the same buffer still resolve — the init segment is looked up
+/// first, then the ranges.
+pub(crate) fn parse_appended(
+    bytes: &[u8],
+    known_init: &Option<Mp4InitInfo>,
+) -> (Option<Mp4InitInfo>, Vec<(f64, f64)>) {
+    let found_init = parse_init_segment(bytes);
+    let init = found_init.clone().or_else(|| known_init.clone());
+    let ranges = match &init {
+        Some(init) => segment_ranges(bytes, init),
+        None => Vec::new(),
+    };
+    (found_init, ranges)
+}
+
+/// Apply a `SourceBuffer`'s `timestampOffset` and append window to a
+/// segment range. Returns `None` if the range falls entirely outside
+/// the window.
+pub(crate) fn apply_append_window(
+    range: (f64, f64),
+    timestamp_offset: f64,
+    window_start: f64,
+    window_end: f64,
+) -> Option<(f64, f64)> {
+    let start = (range.0 + timestamp_offset).max(window_start);
+    let end = (range.1 + timestamp_offset).min(window_end);
+    if end > start {
+        Some((start, end))
+    } else {
+        None
+    }
+}
+
+/// Remove `[start, end)` from `ranges`, splitting ranges that
+/// straddle the removed interval. Used by `SourceBuffer.remove()`.
+/// Note this is bookkeeping only: the player keeps the bytes it was
+/// already handed, and there is no player API to un-buffer them.
+pub(crate) fn subtract_range(ranges: &mut Vec<(f64, f64)>, start: f64, end: f64) {
+    let mut out = Vec::with_capacity(ranges.len());
+    for &(s, e) in ranges.iter() {
+        if e <= start || s >= end {
+            out.push((s, e));
+            continue;
+        }
+        if s < start {
+            out.push((s, start));
+        }
+        if e > end {
+            out.push((end, e));
+        }
+    }
+    *ranges = out;
+}
