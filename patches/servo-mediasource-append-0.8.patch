+    /// Drain every attached source buffer's queued bytes into the
+    /// player. Called from the source buffers' `updateend` tasks, from
+    /// `NeedData`, and from attach.
+    pub(crate) fn drain_media_source_buffers(&self) {
+        let Some(media_source) = self.attached_media_source.get() else {
+            return;
+        };
+        for buffer in media_source.source_buffers() {
