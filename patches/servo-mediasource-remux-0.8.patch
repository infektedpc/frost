diff --git a/components/script/dom/media/mux.rs b/components/script/dom/media/mux.rs
new file mode 100644
index 000000000..fa723de48
--- /dev/null
+++ b/components/script/dom/media/mux.rs
@@ -0,0 +1,761 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! MSE remuxer: merge the per-track fragmented-MP4 streams of a
+//! `MediaSource`'s `SourceBuffer`s into the single valid stream the
+//! player can consume.
+//!
+//! Round 20: the player has ONE push source (`ServoSrc` → `qtdemux`)
+//! per media element, and every `SourceBuffer` drains into it
+//! (`SourceBuffer::drain_pending`). A real YouTube player appends one
+//! init segment per track — video `ftyp`+`moov` (track 1) and audio
+//! `ftyp`+`moov` (also track 1) — so the byte stream the player saw
+//! had TWO `moov` boxes and two tracks both numbered 1. `qtdemux`
+//! cannot negotiate that stream: the pipeline died with
+//! `not-negotiated (-4)` and every later push failed
+//! (`BufferPushFailed`). A single combined mux (one `moov`, two
+//! tracks, interleaved `moof`s) plays fine — probe3 proved it — so
+//! the fix is to merge here, at the MSE layer, before pushing.
+//!
+//! What the muxer does, per attached `MediaSource`:
+//! * One `SourceBuffer` only: pass-through. Chunks go to the player
+//!   byte-identical to Round 19 — no rebuild, no rewrite.
+//! * Two or more buffers: hold init segments and media chunks until
+//!   every existing buffer has supplied its init, then emit ONE
+//!   combined init — the first track's `ftyp` plus a fresh `moov`
+//!   built from the copied `trak` boxes (track IDs reassigned so
+//!   they are distinct) and a fresh `mvex` — followed by the held
+//!   media in presentation-time order. After that, each `moof` has
+//!   its `tfhd` track ID rewritten to the merged ID and its `mfhd`
+//!   sequence number renumbered in emission order. `mdat` bytes are
+//!   never touched.
+//!
+//! Limits (documented, not hidden):
+//! * All `SourceBuffer`s must append their init segment before any
+//!   media flows — media appended while an init is missing is held,
+//!   not dropped, and flushes once the init arrives. A buffer that
+//!   never appends an init stalls the stream.
+//! * A buffer created after the combined init was emitted, or an
+//!   init appended after it, is too late: its track is not in the
+//!   stream, so its init and media are dropped with a warning.
+//! * Media appended before its own buffer's init is held until the
+//!   init arrives (the MSE spec requires init first).
+
+use std::cmp::Ordering;
+
+use log::warn;
+
+use crate::dom::media::mp4::{
+    children, parse_init_segment, read_box, segment_ranges, Mp4InitInfo,
+};
+
+/// Write a plain box: 32-bit big-endian size, four-byte type, payload.
+fn bx(typ: &[u8; 4], payload: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(payload.len() + 8);
+    out.extend_from_slice(&((payload.len() + 8) as u32).to_be_bytes());
+    out.extend_from_slice(typ);
+    out.extend_from_slice(payload);
+    out
+}
+
+/// Write a FullBox: version 0, flags 0, then the payload.
+fn fullbx(typ: &[u8; 4], payload: &[u8]) -> Vec<u8> {
+    let mut p = vec![0u8, 0, 0, 0];
+    p.extend_from_slice(payload);
+    bx(typ, &p)
+}
+
+/// Top-level boxes of `data`: (type, box start, content start, next
+/// box start). `read_box` gives content/next; the box start is the
+/// offset we walked from.
+fn top_boxes(data: &[u8]) -> Vec<([u8; 4], usize, usize, usize)> {
+    let mut out = Vec::new();
+    let mut offset = 0;
+    while offset + 8 <= data.len() {
+        let Some((typ, content, next)) = read_box(data, offset) else {
+            break;
+        };
+        if next > data.len() {
+            break;
+        }
+        out.push((typ, offset, content, next));
+        offset = next;
+    }
+    out
+}
+
+/// One track's init segment, as fed by its `SourceBuffer`.
+#[derive(Clone, Debug, JSTraceable, MallocSizeOf)]
+struct MuxTrack {
+    /// Creation-order key of the `SourceBuffer` that owns this track.
+    key: u32,
+    /// Track ID assigned in the merged stream (1, 2, …).
+    new_track_id: u32,
+    /// The `ftyp` box of this track's init segment.
+    ftyp: Vec<u8>,
+    /// The raw `trak` box bytes of this track's init segment.
+    trak: Vec<u8>,
+    /// Parsed init info (timescales, durations, handlers).
+    init: Mp4InitInfo,
+}
+
+/// A media chunk held back until the combined init can be emitted.
+#[derive(Clone, Debug, JSTraceable, MallocSizeOf)]
+struct HeldMedia {
+    key: u32,
+    bytes: Vec<u8>,
+    /// Presentation start in seconds (from the chunk's `tfdt`).
+    start: f64,
+    /// Arrival order, for stable sorting of equal starts.
+    order: u64,
+}
+
+/// The per-`MediaSource` remuxer state.
+#[derive(Debug, Default, JSTraceable, MallocSizeOf)]
+pub(crate) struct MseMuxer {
+    tracks: Vec<MuxTrack>,
+    /// The combined init has been emitted to the player.
+    init_emitted: bool,
+    /// Single-buffer mode, decided at the first feed: chunks pass
+    /// through byte-identical (Round 19 behavior).
+    passthrough: bool,
+    /// The one buffer allowed through in pass-through mode.
+    passthrough_key: u32,
+    /// Media chunks held while the combined init is not ready.
+    held: Vec<HeldMedia>,
+    /// Next `mfhd` sequence number for emitted `moof`s.
+    sequence: u32,
+    /// Arrival counter for stable held-media ordering.
+    order: u64,
+}
+
+/// What a chunk splits into: an init part (`ftyp`/`moov`, if any)
+/// and media units (each a `moof` plus its following `mdat`s).
+struct ChunkParts {
+    init: Option<Vec<u8>>,
+    media: Vec<Vec<u8>>,
+}
+
+fn split_chunk(bytes: &[u8]) -> ChunkParts {
+    let mut init = Vec::new();
+    let mut media = Vec::new();
+    let mut current: Option<Vec<u8>> = None;
+    for (typ, start, _content, next) in top_boxes(bytes) {
+        match &typ {
+            b"ftyp" | b"moov" => {
+                init.extend_from_slice(&bytes[start..next]);
+            },
+            b"moof" => {
+                if let Some(unit) = current.take() {
+                    media.push(unit);
+                }
+                current = Some(bytes[start..next].to_vec());
+            },
+            b"mdat" => {
+                if let Some(unit) = current.as_mut() {
+                    unit.extend_from_slice(&bytes[start..next]);
+                }
+                // An `mdat` with no preceding `moof` is dropped.
+            },
+            // `sidx`, `mfra`, `free`, … carry no media; dropped.
+            _ => {},
+        }
+    }
+    if let Some(unit) = current.take() {
+        media.push(unit);
+    }
+    ChunkParts {
+        init: if init.is_empty() { None } else { Some(init) },
+        media,
+    }
+}
+
+/// Patch the track ID of the `tkhd` box inside copied `trak` bytes.
+/// `tkhd` is a FullBox: version/flags, then creation/modification
+/// times (4 bytes each for v0, 8 for v1), then the track ID.
+fn patch_tkhd_track_id(trak: &mut [u8], new_id: u32) {
+    // Find the track ID offset first, then patch: the `children`
+    // walk borrows `trak`, so it cannot be mutated inside it.
+    let mut tkhd_at: Option<usize> = None;
+    children(trak, 8, trak.len(), |typ, content, _next| {
+        if &typ == b"tkhd" {
+            let version = trak.get(content).copied().unwrap_or(0);
+            tkhd_at = Some(if version == 0 { content + 12 } else { content + 20 });
+        }
+    });
+    if let Some(at) = tkhd_at {
+        if let Some(slot) = trak.get_mut(at..at + 4) {
+            slot.copy_from_slice(&new_id.to_be_bytes());
+        }
+    }
+}
+
+/// Build a fresh `mvhd`: timescale 1000, duration the longest track.
+fn build_mvhd(duration_ms: u32, next_track_id: u32) -> Vec<u8> {
+    let mut p = Vec::new();
+    p.extend_from_slice(&0u32.to_be_bytes()); // creation_time
+    p.extend_from_slice(&0u32.to_be_bytes()); // modification_time
+    p.extend_from_slice(&1000u32.to_be_bytes()); // timescale
+    p.extend_from_slice(&duration_ms.to_be_bytes()); // duration
+    p.extend_from_slice(&0x00010000u32.to_be_bytes()); // rate 1.0
+    p.extend_from_slice(&0x0100u16.to_be_bytes()); // volume 1.0
+    p.extend_from_slice(&0u16.to_be_bytes()); // reserved
+    p.extend_from_slice(&0u64.to_be_bytes()); // reserved
+    for v in [0x00010000u32, 0, 0, 0, 0x00010000, 0, 0, 0, 0x40000000] {
+        p.extend_from_slice(&v.to_be_bytes());
+    }
+    p.extend_from_slice(&[0u8; 24]); // pre_defined
+    p.extend_from_slice(&next_track_id.to_be_bytes());
+    fullbx(b"mvhd", &p)
+}
+
+/// Build one `trex`: all sample defaults zero except the description
+/// index (each track's `stsd` has exactly one entry).
+fn build_trex(track_id: u32) -> Vec<u8> {
+    let mut p = Vec::new();
+    p.extend_from_slice(&track_id.to_be_bytes());
+    p.extend_from_slice(&1u32.to_be_bytes()); // default_sample_description_index
+    p.extend_from_slice(&0u32.to_be_bytes()); // default_sample_duration
+    p.extend_from_slice(&0u32.to_be_bytes()); // default_sample_size
+    p.extend_from_slice(&0u32.to_be_bytes()); // default_sample_flags
+    fullbx(b"trex", &p)
+}
+
+/// A minimal `ftyp` fallback, used only if no fed init had one
+/// (YouTube inits always do).
+fn fallback_ftyp() -> Vec<u8> {
+    bx(b"ftyp", b"isom\0\0\0\0isomiso6mp41")
+}
+
+/// The result of feeding one chunk to the remuxer.
+#[derive(Debug, Default)]
+pub(crate) struct FeedResult {
+    /// The chunk was taken by the muxer (held for the combined init
+    /// or emitted). If false, the chunk was dropped — its track is
+    /// not in the stream (a late init or a late buffer) — and the
+    /// caller should discard it.
+    pub(crate) accepted: bool,
+    /// Byte chunks to push to the player, in order.
+    pub(crate) chunks: Vec<Vec<u8>>,
+}
+
+impl MseMuxer {
+    /// Feed one appended chunk from the `SourceBuffer` with `key`.
+    /// `buffer_count` is the number of `SourceBuffer`s on the
+    /// `MediaSource` right now. Returns the chunks to push to the
+    /// player, in order — possibly empty (chunk held for the
+    /// combined init) or several (combined init plus flushed media).
+    pub(crate) fn feed(
+        &mut self,
+        key: u32,
+        bytes: Vec<u8>,
+        buffer_count: usize,
+    ) -> FeedResult {
+        // Single-buffer mode, decided at the first feed: pass chunks
+        // through byte-identical (Round 19 behavior). A buffer that
+        // appears later cannot join a stream that already committed
+        // to one track.
+        if self.passthrough {
+            if key == self.passthrough_key {
+                return FeedResult {
+                    accepted: true,
+                    chunks: vec![bytes],
+                };
+            }
+            warn!("MSE remux: dropping data from a SourceBuffer created after playback started (single-track stream)");
+            return FeedResult::default();
+        }
+        if self.tracks.is_empty() && self.held.is_empty() && !self.init_emitted {
+            // First feed ever: one buffer means pass-through.
+            if buffer_count <= 1 {
+                self.passthrough = true;
+                self.passthrough_key = key;
+                return FeedResult {
+                    accepted: true,
+                    chunks: vec![bytes],
+                };
+            }
+        }
+
+        let parts = split_chunk(&bytes);
+        let mut out = Vec::new();
+        let mut accepted = false;
+
+        // Init part: register the track (unless it is too late).
+        if let Some(init_bytes) = parts.init {
+            if self.init_emitted {
+                warn!("MSE remux: dropping late init segment (track not in the emitted stream)");
+                // The chunk's media belongs to the same late track.
+                return FeedResult::default();
+            }
+            if self.register_init(key, &init_bytes).is_none() {
+                warn!("MSE remux: dropping unparseable init segment");
+                return FeedResult::default();
+            }
+            accepted = true;
+        }
+
+        // Media parts: rewrite now if the stream is open, else hold.
+        for unit in parts.media {
+            if self.init_emitted {
+                match self.rewrite_moof(unit, key) {
+                    Some(rewritten) => {
+                        out.push(rewritten);
+                        accepted = true;
+                    },
+                    None => {
+                        warn!("MSE remux: dropping media from an unknown track");
+                    },
+                }
+            } else {
+                let start = self.media_start(&unit, key);
+                self.held.push(HeldMedia {
+                    key,
+                    bytes: unit,
+                    start,
+                    order: self.order,
+                });
+                self.order += 1;
+                accepted = true;
+            }
+        }
+
+        // Emit the combined init once every existing buffer has
+        // supplied its init, flushing held media in time order.
+        if !self.init_emitted && self.all_buffers_have_inits(buffer_count) {
+            let mut flushed = vec![self.build_combined_init()];
+            self.init_emitted = true;
+            self.held.sort_by(|a, b| {
+                a.start
+                    .partial_cmp(&b.start)
+                    .unwrap_or(Ordering::Equal)
+                    .then_with(|| a.order.cmp(&b.order))
+            });
+            for held in std::mem::take(&mut self.held) {
+                if let Some(rewritten) = self.rewrite_moof(held.bytes, held.key) {
+                    flushed.push(rewritten);
+                }
+            }
+            flushed.extend(out);
+            return FeedResult {
+                accepted: true,
+                chunks: flushed,
+            };
+        }
+        FeedResult {
+            accepted,
+            chunks: out,
+        }
+    }
+
+    /// Do all existing buffers have a registered init?
+    fn all_buffers_have_inits(&self, buffer_count: usize) -> bool {
+        !self.tracks.is_empty() && self.tracks.len() >= buffer_count
+    }
+
+    /// Parse and store one buffer's init segment. Returns the parsed
+    /// info, or `None` if no usable `moov` is present. Re-registering
+    /// a key replaces its track (same buffer appending a new init
+    /// before the combined init went out).
+    fn register_init(&mut self, key: u32, init_bytes: &[u8]) -> Option<()> {
+        let init = parse_init_segment(init_bytes)?;
+        if init.tracks.is_empty() {
+            return None;
+        }
+        // Capture the raw `trak` bytes (one per track in this init)
+        // and the `ftyp` for the combined init.
+        let mut ftyp = Vec::new();
+        let mut traks: Vec<Vec<u8>> = Vec::new();
+        for (typ, start, content, next) in top_boxes(init_bytes) {
+            match &typ {
+                b"ftyp" => {
+                    if ftyp.is_empty() {
+                        ftyp = init_bytes[start..next].to_vec();
+                    }
+                },
+                b"moov" => {
+                    children(init_bytes, content, next, |typ, content, next| {
+                        if &typ == b"trak" {
+                            // The `trak` box starts 8 bytes before its
+                            // content (size + type header).
+                            let box_start = content - 8;
+                            traks.push(init_bytes[box_start..next].to_vec());
+                        }
+                    });
+                },
+                _ => {},
+            }
+        }
+        if traks.is_empty() {
+            return None;
+        }
+        // One init per buffer in practice; if an init carries several
+        // tracks, keep the first and warn about the rest (their
+        // `moof`s would have no buffer to attribute them to).
+        if traks.len() > 1 {
+            warn!("MSE remux: init segment carries {} tracks, keeping the first", traks.len());
+        }
+        let new_track_id = match self.tracks.iter().find(|t| t.key == key) {
+            Some(track) => track.new_track_id,
+            None => (self.tracks.len() + 1) as u32,
+        };
+        let track = MuxTrack {
+            key,
+            new_track_id,
+            ftyp,
+            trak: traks.remove(0),
+            init,
+        };
+        if let Some(slot) = self.tracks.iter_mut().find(|t| t.key == key) {
+            *slot = track;
+        } else {
+            self.tracks.push(track);
+        }
+        Some(())
+    }
+
+    /// Build the combined init: first track's `ftyp` + fresh `moov`
+    /// (new `mvhd`, copied `trak`s with reassigned IDs, fresh `mvex`).
+    fn build_combined_init(&self) -> Vec<u8> {
+        let ftyp = self
+            .tracks
+            .first()
+            .map(|t| t.ftyp.clone())
+            .filter(|f| !f.is_empty())
+            .unwrap_or_else(fallback_ftyp);
+        let max_duration = self
+            .tracks
+            .iter()
+            .flat_map(|t| t.init.tracks.iter().map(|tr| tr.duration_secs))
+            .fold(0.0f64, f64::max);
+        let next_id = self
+            .tracks
+            .iter()
+            .map(|t| t.new_track_id)
+            .max()
+            .unwrap_or(0)
+            + 1;
+        let mut moov_payload = build_mvhd((max_duration * 1000.0).round() as u32, next_id);
+        for track in &self.tracks {
+            let mut trak = track.trak.clone();
+            patch_tkhd_track_id(&mut trak, track.new_track_id);
+            moov_payload.extend_from_slice(&trak);
+        }
+        let mut mvex_payload = Vec::new();
+        for track in &self.tracks {
+            mvex_payload.extend_from_slice(&build_trex(track.new_track_id));
+        }
+        moov_payload.extend_from_slice(&bx(b"mvex", &mvex_payload));
+        let mut out = ftyp;
+        out.extend_from_slice(&bx(b"moov", &moov_payload));
+        out
+    }
+
+    /// Presentation start of a media unit, in seconds, from its first
+    /// `moof`'s `tfdt` and its track's timescale. `f64::MAX` when it
+    /// cannot be determined (sorts last).
+    fn media_start(&self, unit: &[u8], key: u32) -> f64 {
+        let Some(track) = self.tracks.iter().find(|t| t.key == key) else {
+            return f64::MAX;
+        };
+        segment_ranges(unit, &track.init)
+            .first()
+            .map(|r| r.0)
+            .unwrap_or(f64::MAX)
+    }
+
+    /// Rewrite one media unit for the merged stream: `tfhd` track IDs
+    /// become the track's merged ID, `mfhd` sequence numbers run
+    /// consecutively in emission order. Returns `None` if the unit's
+    /// track is not in the merged stream.
+    fn rewrite_moof(&mut self, mut bytes: Vec<u8>, key: u32) -> Option<Vec<u8>> {
+        let new_id = self.tracks.iter().find(|t| t.key == key)?.new_track_id;
+        let mut offset = 0;
+        while offset + 8 <= bytes.len() {
+            let Some((typ, content, next)) = read_box(&bytes, offset) else {
+                break;
+            };
+            if next > bytes.len() {
+                break;
+            }
+            if &typ == b"moof" {
+                // Walk the moof's children: `mfhd` (renumber) and
+                // `traf` → `tfhd` (retarget the track).
+                let mut child = content;
+                while child + 8 <= next {
+                    let Some((ctyp, ccontent, cnext)) = read_box(&bytes, child) else {
+                        break;
+                    };
+                    if cnext > next {
+                        break;
+                    }
+                    if &ctyp == b"mfhd" {
+                        self.sequence += 1;
+                        if let Some(slot) = bytes.get_mut(ccontent + 4..ccontent + 8) {
+                            slot.copy_from_slice(&self.sequence.to_be_bytes());
+                        }
+                    } else if &ctyp == b"traf" {
+                        let mut inner = ccontent;
+                        while inner + 8 <= cnext {
+                            let Some((ityp, icontent, inext)) = read_box(&bytes, inner) else {
+                                break;
+                            };
+                            if inext > cnext {
+                                break;
+                            }
+                            if &ityp == b"tfhd" {
+                                if let Some(slot) = bytes.get_mut(icontent + 4..icontent + 8) {
+                                    slot.copy_from_slice(&new_id.to_be_bytes());
+                                }
+                            }
+                            inner = inext;
+                        }
+                    }
+                    child = cnext;
+                }
+            }
+            offset = next;
+        }
+        Some(bytes)
+    }
+}
