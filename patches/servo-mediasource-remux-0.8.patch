+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::dom::media::mp4::parse_init_segment;
+
+    fn mvhd(timescale: u32, duration: u32) -> Vec<u8> {
+        let mut p = Vec::new();
+        p.extend_from_slice(&0u32.to_be_bytes());
+        p.extend_from_slice(&0u32.to_be_bytes());
+        p.extend_from_slice(&timescale.to_be_bytes());
+        p.extend_from_slice(&duration.to_be_bytes());
+        fullbx(b"mvhd", &p)
+    }
+
+    fn trak(track_id: u32, timescale: u32, duration: u32, handler: &[u8; 4]) -> Vec<u8> {
+        let mut tkhd = Vec::new();
+        tkhd.extend_from_slice(&0u32.to_be_bytes());
+        tkhd.extend_from_slice(&0u32.to_be_bytes());
+        tkhd.extend_from_slice(&track_id.to_be_bytes());
+        let tkhd = fullbx(b"tkhd", &tkhd);
+        let mut mdhd = Vec::new();
+        mdhd.extend_from_slice(&0u32.to_be_bytes());
+        mdhd.extend_from_slice(&0u32.to_be_bytes());
+        mdhd.extend_from_slice(&timescale.to_be_bytes());
+        mdhd.extend_from_slice(&duration.to_be_bytes());
+        let mdhd = fullbx(b"mdhd", &mdhd);
+        let mut hdlr = Vec::new();
+        hdlr.extend_from_slice(&0u32.to_be_bytes());
+        hdlr.extend_from_slice(handler);
+        let hdlr = fullbx(b"hdlr", &hdlr);
+        let mut mdia = Vec::new();
+        mdia.extend_from_slice(&mdhd);
+        mdia.extend_from_slice(&hdlr);
+        let mdia = bx(b"mdia", &mdia);
+        let mut t = Vec::new();
+        t.extend_from_slice(&tkhd);
+        t.extend_from_slice(&mdia);
+        bx(b"trak", &t)
+    }
+
+    fn init_segment(track_id: u32, timescale: u32, duration: u32, handler: &[u8; 4]) -> Vec<u8> {
+        let mut moov = Vec::new();
+        moov.extend_from_slice(&mvhd(1000, 0));
+        moov.extend_from_slice(&trak(track_id, timescale, duration, handler));
+        let moov = bx(b"moov", &moov);
+        let mut out = bx(b"ftyp", b"isom\0\0\0\0isomiso2");
+        out.extend_from_slice(&moov);
+        out
+    }
+
+    /// A moof with one traf: tfdt base, one trun, `count` samples of
+    /// `sample_duration` ticks (tfhd default duration).
+    fn moof(track_id: u32, base: u64, sample_duration: u32, count: u32) -> Vec<u8> {
+        let mut tfhd = Vec::new();
+        tfhd.extend_from_slice(&track_id.to_be_bytes());
+        tfhd.extend_from_slice(&sample_duration.to_be_bytes());
+        let mut tfhd = fullbx(b"tfhd", &tfhd);
+        tfhd[8..12].copy_from_slice(&0x020008u32.to_be_bytes());
+        let mut tfdt = Vec::new();
+        tfdt.extend_from_slice(&(base as u32).to_be_bytes());
+        let tfdt = fullbx(b"tfdt", &tfdt);
+        let mut trun = Vec::new();
+        trun.extend_from_slice(&count.to_be_bytes());
+        trun.extend_from_slice(&0i32.to_be_bytes());
+        let mut trun = fullbx(b"trun", &trun);
+        trun[8..12].copy_from_slice(&0x000001u32.to_be_bytes());
+        let mut traf = Vec::new();
+        traf.extend_from_slice(&tfhd);
+        traf.extend_from_slice(&tfdt);
+        traf.extend_from_slice(&trun);
+        let traf = bx(b"traf", &traf);
+        let mut moof = Vec::new();
+        moof.extend_from_slice(&bx(b"mfhd", &1u32.to_be_bytes()));
+        moof.extend_from_slice(&traf);
+        bx(b"moof", &moof)
+    }
+
+    /// Read the `tfhd` track ID and `mfhd` sequence out of a moof.
+    fn moof_ids(bytes: &[u8]) -> (u32, u32) {
+        let mut track_id = 0;
+        let mut sequence = 0;
+        for (typ, content, next) in top_boxes(bytes) {
+            if &typ != b"moof" {
+                continue;
+            }
+            children(bytes, content, next, |typ, content, next| {
+                if &typ == b"mfhd" {
+                    sequence = u32::from_be_bytes(
+                        bytes[content + 4..content + 8].try_into().unwrap(),
+                    );
+                } else if &typ == b"traf" {
+                    children(bytes, content, next, |typ, content, _next| {
+                        if &typ == b"tfhd" {
+                            track_id = u32::from_be_bytes(
+                                bytes[content + 4..content + 8].try_into().unwrap(),
+                            );
+                        }
+                    });
+                }
+            });
+        }
+        (track_id, sequence)
+    }
+
+    /// Count the `trex` boxes in a `moov` and collect their track IDs.
+    fn trex_ids(init: &[u8]) -> Vec<u32> {
+        let mut ids = Vec::new();
+        for (typ, content, next) in top_boxes(init) {
+            if &typ != b"moov" {
+                continue;
+            }
+            children(init, content, next, |typ, content, next| {
+                if &typ == b"mvex" {
+                    children(init, content, next, |typ, content, _next| {
+                        if &typ == b"trex" {
+                            ids.push(u32::from_be_bytes(
+                                init[content + 4..content + 8].try_into().unwrap(),
+                            ));
+                        }
+                    });
+                }
+            });
+        }
+        ids
+    }
+
+    #[test]
+    fn single_buffer_passes_through_unchanged() {
+        let mut muxer = MseMuxer::default();
+        let init = init_segment(1, 15360, 288000, b"vide");
+        let seg = moof(1, 0, 512, 60);
+        let mut chunk = init.clone();
+        chunk.extend_from_slice(&seg);
+        // One buffer: the chunk goes out byte-identical.
+        let result = muxer.feed(0, chunk.clone(), 1);
+        assert!(result.accepted);
+        assert_eq!(result.chunks, vec![chunk]);
+        // A later media chunk is likewise untouched.
+        let result = muxer.feed(0, seg.clone(), 1);
+        assert!(result.accepted);
+        assert_eq!(result.chunks, vec![seg]);
+    }
+
+    #[test]
+    fn two_buffers_merge_into_one_moov() {
+        let mut muxer = MseMuxer::default();
+        let v_init = init_segment(1, 15360, 288000, b"vide");
+        let a_init = init_segment(1, 44100, 840000, b"soun");
+        // Video init alone: held (audio init still missing).
+        assert!(muxer.feed(0, v_init, 2).chunks.is_empty());
+        // Audio init completes the set: the combined init comes out.
+        let out = muxer.feed(1, a_init, 2).chunks;
+        assert_eq!(out.len(), 1);
+        let combined = &out[0];
+        let parsed = parse_init_segment(combined).expect("combined init parses");
+        assert_eq!(parsed.tracks.len(), 2);
+        assert_eq!(parsed.tracks[0].track_id, 1);
+        assert_eq!(parsed.tracks[0].timescale, 15360);
+        assert_eq!(parsed.tracks[0].handler, *b"vide");
+        assert_eq!(parsed.tracks[1].track_id, 2);
+        assert_eq!(parsed.tracks[1].timescale, 44100);
+        assert_eq!(parsed.tracks[1].handler, *b"soun");
+        assert_eq!(trex_ids(combined), vec![1, 2]);
+    }
+
+    #[test]
+    fn moofs_are_retargeted_and_sequenced() {
+        let mut muxer = MseMuxer::default();
+        muxer.feed(0, init_segment(1, 15360, 288000, b"vide"), 2);
+        muxer.feed(1, init_segment(1, 44100, 840000, b"soun"), 2);
+        // Video moof (original track 1) stays 1; audio moof (original
+        // track 1) becomes 2; sequences run 1, 2 in emission order.
+        let out = muxer.feed(0, moof(1, 0, 512, 60), 2).chunks;
+        assert_eq!(out.len(), 1);
+        assert_eq!(moof_ids(&out[0]), (1, 1));
+        let out = muxer.feed(1, moof(1, 0, 1024, 84), 2).chunks;
+        assert_eq!(out.len(), 1);
+        assert_eq!(moof_ids(&out[0]), (2, 2));
+    }
+
+    #[test]
+    fn held_media_flushes_in_timestamp_order() {
+        let mut muxer = MseMuxer::default();
+        muxer.feed(0, init_segment(1, 15360, 288000, b"vide"), 2);
+        // Two video segments held out of order (4 s then 0 s).
+        let late = moof(1, 61440, 512, 60); // tfdt 61440 = 4.0 s
+        let early = moof(1, 0, 512, 60); // tfdt 0 = 0.0 s
+        assert!(muxer.feed(0, late, 2).chunks.is_empty());
+        assert!(muxer.feed(0, early, 2).chunks.is_empty());
+        // The audio init completes the set: combined init, then the
+        // held segments earliest-first.
+        let out = muxer.feed(1, init_segment(1, 44100, 840000, b"soun"), 2).chunks;
+        assert_eq!(out.len(), 3);
+        // out[0] is the combined init; out[1] the 0 s moof (seq 1),
+        // out[2] the 4 s moof (seq 2).
+        assert_eq!(moof_ids(&out[1]), (1, 1));
+        assert_eq!(moof_ids(&out[2]), (1, 2));
+    }
+
+    #[test]
+    fn media_before_init_is_held_then_emitted() {
+        let mut muxer = MseMuxer::default();
+        // Media with no init yet: held, not dropped.
+        assert!(muxer.feed(0, moof(1, 0, 512, 60), 2).chunks.is_empty());
+        muxer.feed(0, init_segment(1, 15360, 288000, b"vide"), 2);
+        // Still held: the audio init is missing.
+        // Audio init completes the set: combined init + held media.
+        let out = muxer.feed(1, init_segment(1, 44100, 840000, b"soun"), 2).chunks;
+        assert_eq!(out.len(), 2);
+        assert_eq!(moof_ids(&out[1]), (1, 1));
+    }
+
+    #[test]
+    fn late_init_and_its_media_are_dropped() {
+        let mut muxer = MseMuxer::default();
+        muxer.feed(0, init_segment(1, 15360, 288000, b"vide"), 2);
+        muxer.feed(1, init_segment(1, 44100, 840000, b"soun"), 2);
+        // A third track's init arrives after the stream committed.
+        assert!(!muxer
+            .feed(2, init_segment(1, 90000, 90000, b"vide"), 3)
+            .accepted);
+        // Its media is dropped too.
+        assert!(!muxer.feed(2, moof(1, 0, 512, 60), 3).accepted);
+    }
+
+    #[test]
+    fn single_buffer_late_second_buffer_is_dropped() {
+        let mut muxer = MseMuxer::default();
+        let init = init_segment(1, 15360, 288000, b"vide");
+        let result = muxer.feed(0, init.clone(), 1);
+        assert!(result.accepted);
+        assert_eq!(result.chunks, vec![init]);
+        // A second buffer appears after pass-through was decided.
+        assert!(!muxer
+            .feed(1, init_segment(1, 44100, 840000, b"soun"), 2)
+            .accepted);
+    }
+}
