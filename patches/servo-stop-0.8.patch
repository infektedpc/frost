+    /// Frost F-001: stop the active document's load, mirroring
+    /// [`Self::handle_reload`]. `Window::Stop` is the `window.stop()`
+    /// path: it aborts the document and reports `LoadStatus::Stopped`.
+    fn handle_stop(&self, cx: &mut JSContext, pipeline_id: PipelineId) {
+        let window = self.documents.borrow().find_window(pipeline_id);
+        if let Some(window) = window {
+            window.Stop(cx);
+        }
+    }
