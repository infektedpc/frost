+    /// Stop loading the currently loading page in this [`WebView`], if any.
+    ///
+    /// Frost F-001: sends a stop request to the script thread of the
+    /// active pipeline, which aborts the document load (the same path as
+    /// `window.stop()` inside the page). The embedder is notified with
+    /// [`LoadStatus::Stopped`] when the load actually stops. A no-op when
+    /// nothing is loading.
+    pub fn stop(&self) {
+        self.servo()
+            .constellation_proxy()
+            .send(EmbedderToConstellationMessage::Stop(self.id()))
+    }
