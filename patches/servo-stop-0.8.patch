+    /// Frost F-001: forward an embedder stop request to the script thread
+    /// of the webview's active pipeline, mirroring [`Self::handle_reload_msg`].
+    fn handle_stop_msg(&mut self, webview_id: WebViewId) {
+        let browsing_context_id = BrowsingContextId::from(webview_id);
+        let pipeline_id = match self.browsing_contexts.get(&browsing_context_id) {
+            Some(browsing_context) => browsing_context.pipeline_id,
+            None => {
+                return warn!("{}: Got stop event after closure", browsing_context_id);
+            },
+        };
+        self.send_message_to_pipeline(
+            pipeline_id,
+            ScriptThreadMessage::Stop(pipeline_id),
+            "Got stop event after closure",
+        );
+    }
