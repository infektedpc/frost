+    /// Fire an `input` event immediately, instead of queueing it.
+    ///
+    /// WayServo round 12/15 fix: for text typed at a keyboard, real
+    /// browsers dispatch the `input` event synchronously as part of
+    /// the keydown default action — before the keyup. Servo queued
+    /// it as a task, so it landed after the keyup, and pages that
+    /// guard on the keydown/keypress (notably xterm.js, which ignores
+    /// a composed `input` while a keydown is outstanding, and ignores
+    /// it after a keypress only while `_keyPressHandled` is still set
+    /// — a flag its keyup handler clears) either dropped the
+    /// character or delivered it twice. Firing it here, from the
+    /// key-reaction path, restores the browser ordering. Cut/paste
+    /// keep the queued version (`queue_input_event`).
+    ///
+    /// 0.8.0 note: this is the round-12 method adapted to the 0.8.0
+    /// API — `InputEvent::new` takes `InputEventFlags` (no separate
+    /// bubbles/cancelable bools, no `is_composing` argument; composing
+    /// is derived from `input_type.is_composing()`), and
+    /// `queue_input_event` / `KeyReaction::DispatchInput` no longer
+    /// carry an `IsComposing` parameter.
+    fn fire_input_event(
+        &self,
+        cx: &mut JSContext,
+        data: Option<String>,
+        input_type: InputEventType,
+    ) {
+        let target = self.as_element().upcast::<EventTarget>();
+        let global = target.global();
+        let window = global.as_window();
+        let mut flags = InputEventFlags::BUBBLES;
+        if input_type.is_composing() {
+            flags |= InputEventFlags::COMPOSING;
+        }
+        let event = InputEvent::new(
+            cx,
+            window,
+            None,
+            atom!("input"),
+            flags,
+            Some(window),
+            0,
+            data.map(DOMString::from),
+            input_type.as_str().into(),
+        );
+        let event = event.upcast::<Event>();
+        event.set_composed(true);
+        event.fire(cx, target);
+    }
+
